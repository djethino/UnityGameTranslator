<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Overrides the netstandard2.0 floor the mod sits on: this one is RUN, not shipped, so it needs
      a framework that can execute. The rules it checks stay on the floor — checking them from the
      outside is the point.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>UnityGameTranslator.Core.Checks</AssemblyName>
    <RootNamespace>UnityGameTranslator.Core.Checks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- The Core carries no nullable annotations; matching it keeps the linked file compiling
         identically on both sides. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    🔴 The FILE, not the assembly — and that is the whole trick.

    UnityGameTranslator.Core references UnityEngine, UniverseLib and TextMeshPro, so a
    ProjectReference here would drag a game engine into a console application and this project
    could not exist. Linking the source file works because that file is pure by contract: no Unity,
    no state, no clock. Nothing about IL2CPP, Mono, fonts or runtimes is involved, because none of
    it is involved in the rules being checked.

    ⚠ The day somebody adds a `using UnityEngine` to a linked file, THIS PROJECT STOPS COMPILING.
    That is the alarm, not an accident — it is what keeps the purity claim honest instead of
    aspirational.
  -->
  <ItemGroup>
    <Compile Include="../../UnityGameTranslator.Core/TextRelations.cs" />
    <Compile Include="../../UnityGameTranslator.Core/InputEcho.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TargetPath.cs" />
    <Compile Include="../../UnityGameTranslator.Core/ModUiMigration.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TranslationLanguages.cs" />
    <!--
      What a downloaded translation may ask of the disk and of the main thread. Both are pure by
      construction — a string in, an answer out — and both exist as files of their own so that the
      refusals AND the acceptances can be proved here rather than in a game.
    -->
    <Compile Include="../../UnityGameTranslator.Core/PlainFileName.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TextRule.cs" />
    <!--
      🔴 The file mechanics, and the reason they are a file of their own.

      The RULES about which interface line goes where were pure and checkable from the first day.
      What actually lost data was neither of them: it was a right rule firing at the wrong MOMENT —
      a save flushed before the file had been read, replacing somebody's interface with an empty
      one, throwing nothing and logging nothing. A moment only exists in a SEQUENCE, so the
      sequence has to be replayable without a game, on real files in a real folder.
    -->
    <Compile Include="../../UnityGameTranslator.Core/ModUiStore.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TranslationEntry.cs" />
    <!--
      The socle, as an assembly rather than as files. It has no Unity reference of any kind — the
      mod, the manager and this project all read the same build — so the reasoning above does not
      apply to it: what it forbids is dragging a game engine in, not sharing a pure library.
    -->
    <ProjectReference Include="../../common/src/UnityGameTranslator.Common/UnityGameTranslator.Common.csproj" />
    <!-- The same version the Core ships, so the file this project writes is byte-identical to the
         one a game writes. A different serialiser would make the round-trip check prove nothing. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- The whole shaping pipeline is pure by contract — stages A/B/C are string work, and the
         vendored RTLTMPro tables carry no Unity reference (their runtime never did). The glob is
         deliberate: a stage added later is checked by default, and if it is not pure, this
         project stops compiling — the alarm, as above. -->
    <Compile Include="../../UnityGameTranslator.Core/TextShaping/**/*.cs"
             Exclude="../../UnityGameTranslator.Core/TextShaping/RtlProbe.cs;../../UnityGameTranslator.Core/TextShaping/RtlPresenter.cs" />
    <!-- Excluded above: RtlProbe (temporary bench tool, Unity-bound) and RtlPresenter (stage D,
         the engine-facing end — it talks to TranslatorCore and components, which is exactly what
         the pure stages must never do). -->
    <!-- The vendored UnicodeClasses loads the bidi trie from ITS OWN assembly — which is this
         one when the files are linked, so the resource must be embedded here too, same logical
         name. -->
    <EmbeddedResource Include="../../UnityGameTranslator.Core/TextShaping/RichTextKit/Resources/BidiClasses.trie"
                      LogicalName="Topten.RichTextKit.Resources.BidiClasses.trie" />
    <!-- The word breaker's dictionaries, same reasoning: it reads them from its own assembly. -->
    <EmbeddedResource Include="../../UnityGameTranslator.Core/TextShaping/Resources/Dictionaries/*.gz"
                      LogicalName="UnityGameTranslator.Core.TextShaping.Dictionaries.%(Filename)%(Extension)" />
    <!-- The font parser and the OpenType layout reader: pure .NET, byte work on a font file —
         the same purity contract as above. The rasterizer's OTHER files (SDF, packing, the
         pipeline) are not here: the pipeline logs through TranslatorCore. -->
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/TtfParser.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/CffParser.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/GlyphData.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/OpenTypeLayout.cs" />
    <!-- The Unicode conformance suite, gzipped (15 MB of text otherwise) — data from the
         Unicode Consortium, not derived from the code under test — and one real font (OFL, see
         TestData/Fonts/LICENSE-*) the layout reader is checked against. -->
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    ⚠ No test framework, deliberately — same reasoning as
    common/tests/UnityGameTranslator.Common.Checks: the mod ships no third-party test dependency,
    so this prints its own results and exits non-zero on failure. `dotnet run` is the whole
    protocol; anything that can run a program can run these.
  -->

</Project>
