<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Overrides the netstandard2.0 floor the mod sits on: this one is RUN, not shipped, so it needs
      a framework that can execute. The rules it checks stay on the floor — checking them from the
      outside is the point.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>UnityGameTranslator.Core.Checks</AssemblyName>
    <RootNamespace>UnityGameTranslator.Core.Checks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- The Core carries no nullable annotations; matching it keeps the linked file compiling
         identically on both sides. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    🔴 The FILE, not the assembly — and that is the whole trick.

    UnityGameTranslator.Core references UnityEngine, UniverseLib and TextMeshPro, so a
    ProjectReference here would drag a game engine into a console application and this project
    could not exist. Linking the source file works because that file is pure by contract: no Unity,
    no state, no clock. Nothing about IL2CPP, Mono, fonts or runtimes is involved, because none of
    it is involved in the rules being checked.

    ⚠ The day somebody adds a `using UnityEngine` to a linked file, THIS PROJECT STOPS COMPILING.
    That is the alarm, not an accident — it is what keeps the purity claim honest instead of
    aspirational.
  -->
  <ItemGroup>
    <Compile Include="../../UnityGameTranslator.Core/TextRelations.cs" />
    <Compile Include="../../UnityGameTranslator.Core/InputEcho.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TargetPath.cs" />
    <!--
      The first of TranslatorCore's cuts (2026-09-08). What a text looks like once the decoration
      is set aside: line endings made one, numbers and markup lifted into placeholders and put
      back, and the two questions about letters. It was ~390 lines scattered through a 9000-line
      file where nothing could ask it anything without a game, a disk and a network.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TextNormalization.cs" />
    <!--
      🔴 When the sweep has been all the way round every kind of text component. A counting rule,
      and it was unreachable: it asked whether they all finished inside the SAME call, which two
      lists longer than a batch can never do. A scene therefore got one pass in its life, and every
      component was refused after it — measured, on a game, as 90 000 visits per five seconds all
      returning at the first line. Nothing about that needs Unity, which is why it belongs here.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ScanRound.cs" />
    <!--
      A typewriter reveal counted on the original, carried over to a longer translation — a ratio
      of two lengths, and the one guard that keeps a game counting on the shown text untouched.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/RevealScale.cs" />
    <!--
      The path matcher both exclusions and font rules read, cut out the same day. What a pattern
      means is a promise to whoever wrote it: an exclusion that quietly stops matching is text
      going to a model that somebody asked to be left alone.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ExclusionPatterns.cs" />
    <!--
      The patterns themselves and what has already been decided for each target. Stateful, and
      that is why it is here: every defect it can carry is a right answer given at the wrong
      moment, which only a replayed sequence can see.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ExclusionRules.cs" />
    <!--
      The font rules, same family: order, memory, and the two verdicts a downloaded pattern can
      earn for a whole run. The log is an injected sink rather than a call into the mod's, so a
      check can read what was said and how often — "once" is half that rule.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/FontRules.cs" />
    <!--
      Where a line of sight meets a box — the arithmetic the inspector picks with. Pure numbers on
      purpose: a sign error in it throws nothing and logs nothing, and shows up in a game only as
      "sometimes I can select that object and sometimes I cannot, depending where I stand".
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/RayBox.cs" />
    <!--
      Which languages a translation is in, and what happens when the file, the machine and the
      server disagree. Which value wins is the socle's; the SEQUENCE is here, and every defect it
      can carry is a right answer taken at the wrong moment.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/LanguageState.cs" />
    <!--
      The texts waiting for a backend. Its whole defect history is one defect — four parallel
      containers describing one item, one of them moving without the others — so every case here
      is a sequence, and the targets it carries are opaque objects it never dereferences.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TranslationQueue.cs" />
    <!--
      The config.json contract and its migrations — a format shared with the Manager, so every key
      is an agreement between two programs. A retired value read as the default takes somebody's
      choice away in silence, which is the only kind of defect this file can have.

      ⚠ TokenProtection comes with it, not as an extra: ModConfig's secrets carry
      [JsonConverter(typeof(EncryptedTokenConverter))] in an attribute, so the converter has to
      compile here for the contract to be checkable at all. It gained its two log sinks for that.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ModConfig.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TokenProtection.cs" />
    <!--
      Which settings a text on screen SHOWS — what decides whether an Apply redraws the game. It
      reads ModConfig by reflection and nothing else, so it belongs beside it here.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ConfigEffects.cs" />
    <!--
      🔴 Reading one server-sent event stream — added because of a defect that cost months and
      that no check could reach: a tick abandoning a pending read, which .NET refuses, so signing
      a game in never completed while the site said it had. A moment, not an answer. The reader is
      a TextReader and the clock is handed in, so the whole sequence replays here.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/SseStream.cs" />
    <!--
      Backends (taking a text apart and putting the answer back) moved to the socle on 2026-09-23,
      with its cases: common/tests/…/LineTranslationChecks.cs.
    -->
    <!--
      What a translations.json yields when it is read — the first slice of separating READING the
      translation file from APPLYING it. Every branch in it can lose a translation without a word,
      and the collision rule (a person over a review over a model) is invisible from anywhere else.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TranslationFileEntries.cs" />
    <!--
      Writing a piece of JSON the same way every time. It feeds the fingerprint that answers "is
      this still the file I copied" across a change of lineage — so unstable, it tells somebody who
      reworked a translation that they changed nothing, or the reverse.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/CanonicalJson.cs" />
    <!--
      What lets one cached sentence serve every value the game puts in it. A pattern that stops
      matching costs one call per number, for ever; one that matches too much shows a sentence
      about something else.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/NumberPatterns.cs" />
    <!--
      The lookup ladder every displayed text climbs — exact, normalized, trimmed, pattern — and
      the three answers it can get. The ORDER is the semantic: a rung answering out of turn shows
      a translation of another line, or queues one the file already holds. A second Core has to
      climb it in this order, and these cases are what holds it to that.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TextGate.cs" />
    <!--
      "Is this text one of OUR translations coming back?" — the anti-loop device every gate asks
      first. Too wide, it refuses genuine source text and the game stays untranslated in silence;
      too narrow, our own output is queued as a new source and published under a target-language
      key. Both only show in a sequence: index, ask, re-decorate, clear, ask again.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ReadbackIndex.cs" />
    <!--
      The post-reload safety net: a text still on screen with the OLD translation is recognised,
      refreshed from the new cache or kept — never queued as a new source line, which is how an
      old translation becomes a KEY in the file. A right answer here is right only after the
      snapshot was taken and against the cache that stands now.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/StaleSnapshot.cs" />
    <!--
      What a translation file states about itself, read into a record with a value for every
      field. The shape that ends the family of "the previous file's answer survives": a key the
      record does not read is a key the next save writes from memory — somebody else's, if
      another file was loaded before.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/LoadedFile.cs" />
    <!--
      What the worker does with one item between the dequeue and the verdict — cache, capture,
      refusal, the backend, a rate limit, an invented token, a stale answer, the filing, the
      notification. The ORDER is what a second Core must reproduce, and several defects paid for
      were defects of order; the host is a recorder here, so the sequence can be read back.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TranslationWorker.cs" />
    <!--
      What the site's answers MEAN on this side: one reader per route, a JSON object in and a
      record out. They sat inline in ApiClient between an HttpClient call and a log line; here
      common/spec/api-v1/cases.json — the file the site replays with PHPUnit — is fed to each
      reader and what it derives is compared to what the case says. The records come with them,
      and carry no clock of their own (the two view helpers take one).
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ApiResults.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Engine/ApiReaders.cs" />
    <!--
      What a downloaded translation may ask of the disk and of the main thread. Both are pure by
      construction — a string in, an answer out — and both exist as files of their own so that the
      refusals AND the acceptances can be proved here rather than in a game.
    -->
    <Compile Include="../../UnityGameTranslator.Core/PlainFileName.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TextRule.cs" />
    <!--
      🔴 The file mechanics, and the reason they are a file of their own.

      The RULES about which interface line goes where were pure and checkable from the first day.
      What actually lost data was neither of them: it was a right rule firing at the wrong MOMENT —
      a save flushed before the file had been read, replacing somebody's interface with an empty
      one, throwing nothing and logging nothing. A moment only exists in a SEQUENCE, so the
      sequence has to be replayable without a game, on real files in a real folder.
    -->
    <Compile Include="../../UnityGameTranslator.Core/ModUiStore.cs" />
    <Compile Include="../../UnityGameTranslator.Core/TranslationEntry.cs" />
    <!--
      Same family, same reason: the fork's ancestor clean-up and the backups' image list were both
      wrong on the NAME of a file or a key, and nothing could see it. Paths and parsed JSON in,
      files gone or names out — replayed here on a real folder.
    -->
    <Compile Include="../../UnityGameTranslator.Core/CompanionFiles.cs" />
    <!-- The file's own facts and the moments they move at: download, upload, merge, fork, write, load. -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TranslationStore.cs" />
    <!--
      How a file reaches the disk (whole, never truncated first) and which of two saves may
      land (the newer, never an older content over it); and the rule that lets a big file cross
      a slow link — a limit per step of a transfer, never on the whole.
    -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/AtomicFile.cs" />
    <!-- The lines the AI gave up on this session, kept to be settled by hand instead of refused in the log. -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/Failures.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Engine/FailureStore.cs" />
    <!-- A long text cut into pieces a label can draw: the canvas mesh's limit, not a figure chosen. -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/TextChunks.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Engine/SaveOrder.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Engine/StallGuard.cs" />
    <!-- The screens' sequence rules: which window is up after which act. No Unity: a view is an IScreen. -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/Screens.cs" />
    <!-- What the engine asks of its host. No Unity: the day it needs one, this stops compiling. -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/EngineHost.cs" />
    <!-- A screen described in data: the document's model and its refusals. Newtonsoft only. -->
    <Compile Include="../../UnityGameTranslator.Core/Engine/ScreenDocument.cs" />
    <!--
      The socle, as an assembly rather than as files. It has no Unity reference of any kind — the
      mod, the manager and this project all read the same build — so the reasoning above does not
      apply to it: what it forbids is dragging a game engine in, not sharing a pure library.
    -->
    <ProjectReference Include="../../common/src/UnityGameTranslator.Common/UnityGameTranslator.Common.csproj" />
    <!-- The same version the Core ships, so the file this project writes is byte-identical to the
         one a game writes. A different serialiser would make the round-trip check prove nothing. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- The whole shaping pipeline is pure by contract — stages A/B/C are string work, and the
         vendored RTLTMPro tables carry no Unity reference (their runtime never did). The glob is
         deliberate: a stage added later is checked by default, and if it is not pure, this
         project stops compiling — the alarm, as above. -->
    <Compile Include="../../UnityGameTranslator.Core/TextShaping/**/*.cs"
             Exclude="../../UnityGameTranslator.Core/TextShaping/RtlProbe.cs;../../UnityGameTranslator.Core/TextShaping/RtlPresenter.cs" />
    <!-- Excluded above: RtlProbe (temporary bench tool, Unity-bound) and RtlPresenter (stage D,
         the engine-facing end — it talks to TranslatorCore and components, which is exactly what
         the pure stages must never do). -->
    <!-- The vendored UnicodeClasses loads the bidi trie from ITS OWN assembly — which is this
         one when the files are linked, so the resource must be embedded here too, same logical
         name. -->
    <EmbeddedResource Include="../../UnityGameTranslator.Core/TextShaping/RichTextKit/Resources/BidiClasses.trie"
                      LogicalName="Topten.RichTextKit.Resources.BidiClasses.trie" />
    <!-- The word breaker's dictionaries, same reasoning: it reads them from its own assembly. -->
    <EmbeddedResource Include="../../UnityGameTranslator.Core/TextShaping/Resources/Dictionaries/*.gz"
                      LogicalName="UnityGameTranslator.Core.TextShaping.Dictionaries.%(Filename)%(Extension)" />
    <!-- The font parser and the OpenType layout reader: pure .NET, byte work on a font file —
         the same purity contract as above. The rasterizer's OTHER files (SDF, packing, the
         pipeline) are not here: the pipeline logs through TranslatorCore. -->
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/TtfParser.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/CffParser.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/GlyphData.cs" />
    <Compile Include="../../UnityGameTranslator.Core/Rasterizer/OpenTypeLayout.cs" />
    <!-- The Unicode conformance suite, gzipped (15 MB of text otherwise) — data from the
         Unicode Consortium, not derived from the code under test — and one real font (OFL, see
         TestData/Fonts/LICENSE-*) the layout reader is checked against. -->
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    ⚠ No test framework, deliberately — same reasoning as
    common/tests/UnityGameTranslator.Common.Checks: the mod ships no third-party test dependency,
    so this prints its own results and exits non-zero on failure. `dotnet run` is the whole
    protocol; anything that can run a program can run these.
  -->

</Project>
